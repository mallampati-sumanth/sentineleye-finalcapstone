# Copy this file to .env.local and use your Supabase project's public client values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Local FastAPI helper. Update if your helper runs on another host or port.
NEXT_PUBLIC_HELPER_URL=http://127.0.0.1:8765

# SMTP email notifications (server-side only; get these from your email provider).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=SentinelEye <alerts@example.com>

# Telegram bot token (server-side only). Set the recipient chat ID in SentinelEye Settings.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
