# Local helper server
HELPER_HOST=0.0.0.0
HELPER_PORT=8000

# Set this to the ESP32's LAN address after flashing the board.
ESP32_BASE_URL=http://192.168.1.50
ESP32_TIMEOUT_SECONDS=1.5

# Alert and upload behavior
ALERT_COOLDOWN_SECONDS=300
MAX_UPLOAD_BYTES=8388608

# Paths are relative to the helper's working directory when not absolute.
SENTINEL_DATA_DIR=./data

# Add the exact origin used by the web console if it differs from localhost.
CORS_ORIGINS=http://localhost:3000
